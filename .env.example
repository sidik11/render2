# Server 2 - Exam API
# Local development only; on Render, the platform PORT variable takes precedence.
SERVER2_PORT=3001
# Local development target. On Render, set this to Server 1's exact HTTPS service URL.
SERVER1_URL=http://127.0.0.1:3000
NODE_ENV=development

# Server 2 Firebase RTDB - exam data only
SERVER2_FIREBASE_PROJECT_ID=
SERVER2_FIREBASE_CLIENT_EMAIL=
SERVER2_FIREBASE_PRIVATE_KEY=
SERVER2_FIREBASE_DATABASE_URL=

# Must match Server 1 exactly; use at least 32 random characters in production.
INTERNAL_AUTH_SECRET=
AUTH_SESSION_SECRET=
